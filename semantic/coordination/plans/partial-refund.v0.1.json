    "deduplicate_by": [
      "root_cause",
      "scope",
      "policy_revision"
    ],
    "response_requires": [
      "request_id",
      "policy_revision",
      "chosen_option",
      "affected_scope"
    ],
    "response_must_pass": [
      "version_check",
      "scope_check",
      "authority_check",
      "invariant_check"
    ]
  },
  "authority": {
    "director": "director",
    "human_authorizer": "human-owner"
  }
