        "diff": "--- src/RefundService.php:base\n+++ src/RefundService.php:current\n@@ -4,7 +4,7 @@\n\n final class RefundService\n {\n-    public const VERSION = 'v1';\n+    public const VERSION = 'v2';\n\n     /**\n      * @return array<string, mixed>\n@@ -25,15 +25,75 @@\n         if ($requestedPercent < 1 || $requestedPercent > 100) {\n             throw new \\InvalidArgumentException('requested percent must be between 1 and 100');\n         }\n-        if ($requestedPercent !== 100) {\n+\n+        if ($requestedPercent === 100) {\n+            return [\n+                'amount_cents' => $amountCents,\n+                'refund_percent' => 100,\n+                'refund_cents' => $amountCents,\n+                'mode' => 'full',\n+            ];\n+        }\n+\n+        $policy = self::policy();\n+\n+        if (($policy['partial_refund_enabled'] ?? false) !== true) {\n             throw new \\InvalidArgumentException('partial refunds are not enabled');\n         }\n\n+        $partialPolicy = $policy['partial_refund'] ?? null;\n+        if (!is_array($partialPolicy)) {\n+            throw new \\InvalidArgumentException('partial refund policy is missing');\n+        }\n+\n+        $minAmountCents = (int) ($partialPolicy['min_amount_cents'] ?? 0);\n+        $partialMaxPercent = (int) ($partialPolicy['max_percent'] ?? 0);\n+\n+        if ($amountCents < $minAmountCents) {\n+            throw new \\InvalidArgumentException('amount is below the partial refund minimum');\n+        }\n+        if ($requestedPercent > $partialMaxPercent) {\n+            throw new \\InvalidArgumentException('requested percent exceeds the partial refund maximum');\n+        }\n+\n+        $tierMaxPercent = self::tierMaxPercent($policy['tiers'] ?? [], $amountCents);\n+        if ($tierMaxPercent === null) {\n+            throw new \\InvalidArgumentException('no refund tier covers this amount');\n+        }\n+        if ($requestedPercent > $tierMaxPercent) {\n+            throw new \\InvalidArgumentException('requested percent exceeds the tier maximum');\n+        }\n+\n         return [\n             'amount_cents' => $amountCents,\n-            'refund_percent' => 100,\n-            'refund_cents' => $amountCents,\n-            'mode' => 'full',\n+            'refund_percent' => $requestedPercent,\n+            'refund_cents' => (int) round($amountCents * $requestedPercent / 100),\n+            'mode' => 'partial',\n         ];\n     }\n+\n+    /**\n+     * @param array<int, array<string, mixed>> $tiers\n+     */\n+    private static function tierMaxPercent(array $tiers, int $amountCents): ?int\n+    {\n+        $selected = null;\n+        $selectedMin = null;\n+\n+        foreach ($tiers as $tier) {\n+            if (!is_array($tier)) {\n+                continue;\n+            }\n+            $tierMin = (int) ($tier['min_amount_cents'] ?? 0);\n+            if ($tierMin > $amountCents) {\n+                continue;\n+            }\n+            if ($selectedMin === null || $tierMin >= $selectedMin) {\n+                $selectedMin = $tierMin;\n+                $selected = (int) ($tier['max_refund_percent'] ?? 0);\n+            }\n+        }\n+\n+        return $selected;\n+    }\n }"
